{
  "name": "hotelogx-connect-backend",
  "version": "1.0.0",
  "description": "Backend API for Hotelogx Connect Hotel Assistant",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "test": "node --test src/tests/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test:gmail": "node --test src/tests/gmailIngestion.test.js",
    "test:gmail:database": "node scripts/test-gmail-database.mjs .env",
    "test:microsoft": "node --test src/tests/microsoftIngestion.test.js",
    "test:microsoft:database": "node scripts/test-microsoft-database.mjs .env",
    "test:imap": "node --test src/tests/imapIngestion.test.js",
    "test:imap:database": "node scripts/test-imap-database.mjs .env",
    "test:reports": "node --test src/tests/dailyReports.test.js",
    "test:operations": "node --test src/tests/reportOperations.test.js",
    "test:operations:database": "node scripts/test-operations-database.mjs .env",
    "test:blockers": "node --test src/tests/operationalBlockers.test.js",
    "test:blockers:database": "node scripts/test-blockers-database.mjs .env",
    "test:handoffs": "node --test src/tests/guestHandoffs.test.js",
    "test:handoffs:database": "node scripts/test-handoffs-database.mjs .env",
    "test:verification": "node --test src/tests/guestVerification.test.js",
    "test:verification:database": "node scripts/test-verification-database.mjs .env",
    "test:whatsapp": "node --test src/tests/whatsappReal.test.js src/tests/whatsappCoexistence.test.js src/tests/whatsappWebhookHttp.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.37",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.16",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.4.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true
  }
}

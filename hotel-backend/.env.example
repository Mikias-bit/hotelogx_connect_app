# PostgreSQL / Neon. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@EP-ID-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@EP-ID.REGION.aws.neon.tech/DB_NAME?sslmode=require"
NODE_ENV=development
PORT=5000
BACKEND_BASE_URL=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app
FRONTEND_BASE_URL=https://hotelogxconnect.netlify.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=replace-with-a-random-secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app/api/email-integrations/google/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app/api/email-integrations/microsoft/callback
# Optional in-process polling. Cloud Run Gmail uses authenticated Scheduler fallback.
EMAIL_POLLING_ENABLED=false

# Gmail push and scheduled maintenance (non-secret settings; see docs/gmail-ingestion.md)
GOOGLE_PUBSUB_TOPIC=projects/hotelogx/topics/gmail-inbound-v2
GOOGLE_PUBSUB_SUBSCRIPTION=projects/hotelogx/subscriptions/gmail-inbound-v2-push
GOOGLE_PUBSUB_AUDIENCE=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-push-v2@hotelogx.iam.gserviceaccount.com
GMAIL_WORKER_AUDIENCE=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app
GMAIL_WORKER_SERVICE_ACCOUNT=gmail-worker-v2@hotelogx.iam.gserviceaccount.com

# Microsoft Graph push workers (see docs/microsoft-ingestion.md)
MICROSOFT_GRAPH_NOTIFICATION_URL=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app/api/webhooks/email/microsoft/notifications
MICROSOFT_TASK_QUEUE=projects/hotelogx/locations/europe-west1/queues/microsoft-inbound-v2
MICROSOFT_WORKER_AUDIENCE=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app
MICROSOFT_WORKER_SERVICE_ACCOUNT=microsoft-worker-v2@hotelogx.iam.gserviceaccount.com

# Scheduled IMAP ingestion (non-secret settings; see docs/imap-ingestion.md)
IMAP_WORKER_AUDIENCE=https://hotelogx-connect-backend-tkissahsva-ez.a.run.app
IMAP_WORKER_SERVICE_ACCOUNT=imap-worker-v2@hotelogx.iam.gserviceaccount.com
